{
  "name": "oatmeal",
  "version": "2.0.0",
  "description": "A local-first meeting notebook for macOS and Windows. Local transcription, private notes, and your choice of AI.",
  "author": "Vedant Soni",
  "license": "MIT",
  "type": "module",
  "homepage": "https://github.com/VedSoni-dev/oatmeal",
  "repository": {
    "type": "git",
    "url": "https://github.com/VedSoni-dev/oatmeal.git"
  },
  "keywords": [
    "meeting-notes",
    "whisper",
    "transcription",
    "claude-code",
    "coding-agent",
    "local-first",
    "granola-alternative",
    "mcp"
  ],
  "scripts": {
    "start": "electron .",
    "mcp": "node scripts/mcp-server.mjs",
    "start:browser": "node capture/server.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:desktop": "playwright test",
    "build:icons": "node scripts/build-icons.mjs",
    "build": "npm run build:icons && electron-builder",
    "build:mac": "npm run build -- --mac",
    "build:win": "npm run build -- --win",
    "pack": "npm run build:icons && electron-builder --dir"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.289",
    "@huggingface/transformers": "^4.3.0",
    "@modelcontextprotocol/sdk": "^1.13.1",
    "@openai/codex": "^0.160.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "prettier": "^3.9.9",
    "sharp": "^0.35.5"
  },
  "main": "desktop/main.mjs",
  "engines": {
    "node": ">=22"
  }
}
